{
  "description": "ClaudeKit dangerous-command guard (pre-bash) only",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/pre-bash.py\""
          }
        ]
      }
    ]
  }
}
