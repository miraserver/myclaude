{
  "description": "SPARV auto-hooks for 2-Action save, EHRB detection, and 3-Question reboot test",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -d .sparv/plan ]; then bash \"${CLAUDE_PLUGIN_ROOT}/scripts/save-progress.sh\" --hook || true; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -d .sparv/plan ]; then bash \"${CLAUDE_PLUGIN_ROOT}/scripts/check-ehrb.sh\" --diff --dry-run || true; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -d .sparv/plan ]; then bash \"${CLAUDE_PLUGIN_ROOT}/scripts/reboot-test.sh\" --strict || exit 2; fi"
          }
        ]
      }
    ]
  }
}
