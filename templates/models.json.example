{
  "default_backend": "codex",
  "default_model": "gpt-6.1-sol",
  "backends": {
    "codex": { "api_key": "" },
    "claude": { "api_key": "" },
    "gemini": { "api_key": "" },
    "opencode": { "api_key": "" }
  },
  "agents": {
    "develop": {
      "backend": "codex",
      "model": "gpt-6.1-sol",
      "reasoning": "xhigh",
      "yolo": true
    },
    "code-explorer": {
      "backend": "claude",
      "model": "claude-sonnet-5-5"
    },
    "code-architect": {
      "backend": "claude",
      "model": "claude-opus-5-5"
    },
    "code-reviewer": {
      "backend": "codex",
      "model": "gpt-6.1-sol",
      "reasoning": "xhigh"
    },
    "oracle": {
      "backend": "claude",
      "model": "claude-opus-5-5",
      "yolo": true
    },
    "librarian": {
      "backend": "codex",
      "model": "gpt-6.1-sol",
      "reasoning": "xhigh",
      "yolo": true
    },
    "explore": {
      "backend": "claude",
      "model": "claude-sonnet-5-5"
    },
    "frontend-ui-ux-engineer": {
      "backend": "claude",
      "model": "claude-opus-5-5"
    },
    "document-writer": {
      "backend": "gemini",
      "model": "gemini-3-flash-preview"
    }
  }
}
